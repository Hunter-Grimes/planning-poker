# Copy to `.env` (or `.env.local`) and restart `npm run dev` to enable TURN.
# Vite only exposes vars prefixed with VITE_ to the client.

# ICE endpoint fetched at startup. For Metered, this is the front-end-safe
# credentials URL including your apiKey (the apiKey is designed to be embedded
# in client code). Leave unset to run STUN-only (same-network play still works).
# VITE_ICE_ENDPOINT=https://your-app.metered.live/api/v1/turn/credentials?apiKey=your-api-key

# PeerJS log verbosity (0–3). Set to 3 to debug a connection problem.
# VITE_PEER_DEBUG=0
